# .env.example
# ── LLM ────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Elasticsearch (RAG) ─────────────────────
ES_URL=https://...elastic-cloud.com:9243
ES_PASSWORD=...
ES_USER=elastic
INDEX_NAME=rag_fallas_pf_v1

# ── Servidor MCP ─────────────────────────────
MCP_SERVER_URL=https://mcp-mantenimiento-...run.app/sse

# ── LangSmith (trazabilidad) ─────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=fallas-hidrocarburos

# ── Backend ──────────────────────────────────
BACKEND_URL=https://backend-fallas-...run.app

# ── Google Cloud ─────────────────────────────
GCP_PROJECT_ID=cobalto-data2
GCP_REGION=us-central1
